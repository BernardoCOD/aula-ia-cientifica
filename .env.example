# Copia este archivo como .env y completa los valores.

# Clave GRATUITA de Google Gemini (sin tarjeta): https://aistudio.google.com/apikey
# Activa el asistente inteligente, el Área de consultas, el Tutor IA y el análisis docente.
GEMINI_API_KEY=

# Opcional: modelo preferido de Gemini (si falla o está saturado se prueban otros solos).
# GEMINI_MODEL=gemma-4-26b-a4b-it
# Opcional: el Área de consultas busca en Wikipedia (gratis). Si tu cuenta tiene la búsqueda
# de Google habilitada, puedes usarla con GEMINI_SEARCH=google.
# GEMINI_SEARCH=google

# Opcional y de pago: clave de Claude (https://console.anthropic.com). Si hay dos claves,
# AI_PROVIDER=claude elige Claude; por defecto se usa Gemini.
ANTHROPIC_API_KEY=

# Opcional: modelo y nivel de esfuerzo (low, medium, high). "low" responde más rápido.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_RESEARCH_EFFORT=medium

# Base de datos SQLite local (se crea sola en la carpeta data/).
DATABASE_URL=file:./data/aula.db

# Acceso al panel docente (/docente).
ADMIN_USERNAME=docente
ADMIN_PASSWORD=

# Firma de las cookies de sesión: cualquier texto largo y aleatorio.
JWT_SECRET=

# Puerto del servidor (por defecto 3000).
# PORT=3000
