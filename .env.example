# Copia este archivo como .env y completa los valores.

# Clave de la API de Claude (https://console.anthropic.com → API Keys).
# Sin ella funcionan los comandos de voz directos, pero no el asistente inteligente,
# el Área de consultas ni el Tutor IA.
ANTHROPIC_API_KEY=

# Opcional: modelo y nivel de esfuerzo (low, medium, high). "low" responde más rápido.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_RESEARCH_EFFORT=medium

# Base de datos SQLite local (se crea sola en la carpeta data/).
DATABASE_URL=file:./data/aula.db

# Acceso al panel docente (/docente).
ADMIN_USERNAME=docente
ADMIN_PASSWORD=

# Firma de las cookies de sesión: cualquier texto largo y aleatorio.
JWT_SECRET=

# Puerto del servidor (por defecto 3000).
# PORT=3000
